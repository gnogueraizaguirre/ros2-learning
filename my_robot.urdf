<?xml version="1.0"?>
<robot name="my_robot">

    <material name="blue">
        <color rgba="0 0 0.8 1"/>
    </material>

    <material name="green">
        <color rgba="0 0.8 0 1"/>
    </material>

    <material name="gray">
        <color rgba="0.3 0.3 0.3 1"/>
    </material>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.6 0.4 0.2"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
    </link>


    <link name="wheel_right_link">
        <visual>
            <geometry>
                <cylinder radius="0.2" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <material name="green"/>
        </visual>
    </link>
    <joint name="base_wheel_right_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_right_link"/>
        <origin xyz="0 -0.2 0.1" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="100" velocity="100"/>
    </joint>


    <link name="wheel_left_link">
        <visual>
            <geometry>
                <cylinder radius="0.2" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <material name="green"/>
        </visual>
    </link>
    <joint name="base_wheel_left_join" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_left_link"/>
        <origin xyz="0 0.2 0.1" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="100" velocity="100"/>
    </joint>

    <link name="caster_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05"/>
            </geometry>
            <origin xyz="0 -0.05 -0" rpy="0 0 0"/>
            <material name="green"/>
        </visual>
    </link>
    <joint name="base_caster_joint" type="continuous">
        <parent link="base_link"/>
        <child link="caster_link"/>
        <origin xyz="0.25 0 0" rpy="1.57 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="100" velocity="100"/>
    </joint>


    <link name="tower_lower_link">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.15"/>
            </geometry>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <material name="gray"/>
        </visual>
    </link>
    <joint name="base_tower_joint" type="fixed">
        <parent link="base_link"/>
        <child link="tower_lower_link"/>
        <origin xyz="0.15 0 0.2" rpy="0 0 0"/>
    </joint>


    <link name="tower_higher_link">
        <visual>
            <geometry>
                <cylinder radius="0.015" length="0.15"/>
            </geometry>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <material name="gray"/>
        </visual>
    </link>
    <joint name="tower_lower_higher_joint" type="prismatic">
        <parent link="tower_lower_link"/>
        <child link="tower_higher_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="0.15" effort="100" velocity="100"/>
    </joint>


    <link name="sensor_link">
        <visual>
            <geometry>
                <box size="0.03 0.3 0.03"/>
            </geometry>
            <origin xyz="0 0 0.015" rpy="0 0 0"/>
        </visual>
    </link>
    <joint name="tower_sensor_joint" type="revolute">
        <parent link="tower_higher_link"/>
        <child link="sensor_link"/>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="100" velocity="100"/>
    </joint>


</robot>